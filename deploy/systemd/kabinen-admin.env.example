# Copy to /etc/tusberne/kabinen-admin.env; never commit real credentials.
TUSBERNE_CABINS_ADMIN_USER=kabinen
TUSBERNE_CABINS_ADMIN_PASSWORD_FILE=/etc/tusberne/kabinen-admin-password
TUSBERNE_CABINS_ADMIN_PORT=8765
# Adjust only when using an authenticated HTTPS reverse proxy:
TUSBERNE_CABINS_ADMIN_ORIGIN=http://127.0.0.1:8765
TUSBERNE_CABINS_OVERRIDES=/var/lib/tusberne-kabinen/overrides.json